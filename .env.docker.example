# Docker deployment environment overrides
# Copy this to .env and adjust values before running docker-deploy.sh
# These variables are passed to docker-compose.yml

# Database passwords (change these in production!)
DB_PASSWORD=temec_secret
DB_ROOT_PASSWORD=temec_root_secret

# Set to "true" on first deploy to seed the database
DB_SEED=false

# External API for PDF processing
EXTERNAL_API_UPLOAD_URL=

# Mail configuration (defaults to log driver)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
